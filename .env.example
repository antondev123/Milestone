# Copy to .env.local and fill in.

# Anthropic — used by scripts/ingest.ts (offline) and /api/grade (runtime)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ElevenLabs Conversational AI
# Agent ID from the dashboard (Agents → your agent → copy ID). Public in the browser.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# API key — only needed server-side for signed URLs if the agent is set to private.
ELEVENLABS_API_KEY=

# Shared secret the ElevenLabs tool webhooks send as a header, so /api/tools/* can't be hit by randoms.
TOOL_WEBHOOK_SECRET=change-me

# Public base URL of this deployment (ElevenLabs needs it to reach the tool routes).
# Local dev: run `ngrok http 3000` and paste the https URL here.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
