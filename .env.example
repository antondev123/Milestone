# Copy to .env.local and fill in.

# Anthropic — used by scripts/ingest.ts (offline) and /api/grade (runtime)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs Conversational AI
# Agent ID from the dashboard (Agents → your agent → copy ID). Public in the browser.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# API key — only needed server-side for signed URLs if the agent is set to private.
ELEVENLABS_API_KEY=
# Study mode read-aloud (REST TTS with timestamps). The voice comes from /settings (default Mark,
# src/lib/voices.ts). Model default eleven_flash_v2_5.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Where /api/tts caches mp3 + word timings (default data/tts). On Fly it lives on the volume.
TTS_CACHE_DIR=

# Shared secret the ElevenLabs tool webhooks send as a header, so /api/tools/* can't be hit by randoms.
TOOL_WEBHOOK_SECRET=change-me

# Public base URL of this deployment (ElevenLabs needs it to reach the tool routes).
# Local dev: run `ngrok http 3000` and paste the https URL here.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Model for free-form "ask" questions answered from the book (cached context). Default claude-sonnet-5; claude-haiku-4-5 if latency bites.
ANTHROPIC_ASK_MODEL=claude-sonnet-5

# Study mode dictation (mic icon in the assistant composer) uses ElevenLabs Scribe with the same
# ELEVENLABS_API_KEY. Optional model override, default scribe_v1.
ELEVENLABS_STT_MODEL=scribe_v1

# Session log (docs: README "Diagnostics"). SQLite + recordings under this dir; default data/progress/logs.
LOG_DIR=
# Gate for /admin/sessions and /api/log/* off localhost. Unset = localhost only.
ADMIN_SECRET=
