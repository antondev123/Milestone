{
  "name": "commute-course",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "node --env-file=.env.local scripts/ingest.ts pom --chapters 1-3",
    "demo:reset": "node scripts/demo-reset.ts",
    "demo:stage": "node scripts/demo-reset.ts --stage",
    "ledger": "node --env-file=.env.local scripts/ledger.ts",
    "sessions": "node --env-file-if-exists=.env.local --no-warnings=ExperimentalWarning scripts/sessions.ts",
    "agent:configure": "node --env-file=.env.local scripts/configure-agent.ts",
    "parse:book": "node scripts/parse-book.ts --in data/courses/pom/raw/pom.txt --out data/courses/pom",
    "validate": "node scripts/validate-course.ts pom",
    "course:verbatim": "node scripts/verbatim-chapter.ts build",
    "deploy:fly": "node --env-file=.env.local scripts/deploy-fly.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@elevenlabs/react": "^1.15.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
